rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────────────
    // Users can read their own profile; only Cloud Functions write tier/subscription.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // written exclusively by Cloud Functions
    }

    // ── Monthly usage counters ────────────────────────────────────────────
    // Users can read their own usage; Cloud Functions write via Admin SDK (bypasses rules).
    match /users/{uid}/usage/{month} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Call packs ───────────────────────────────────────────────────────
    // Users can read their own packs; packs are created/decremented by Cloud Functions.
    match /users/{uid}/packs/{packId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
