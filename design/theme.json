{
  "$comment": "Single source of truth for Parlance's color palette. Edit this file, then run scripts/generate_theme.py to regenerate Parlance/web/theme.css, docs/theme.css, and the native Xcode color assets under Parlance/Assets.xcassets/. Never hardcode colors directly in CSS or Swift.",
  "tokens": {
    "ink": { "light": "#1c1917", "dark": "#e8e0d0" },
    "paper": { "light": "#faf7f2", "dark": "#1a1a1e" },
    "paper2": { "light": "#f4f0e8", "dark": "#242428" },
    "rule": { "light": "#e8e0d0", "dark": "#3a3a40" },
    "muted": { "light": "#6f665d", "dark": "#9d99a1" },
    "accent": {
      "light": "#0b9cd0",
      "dark": "#3db8e8",
      "tint_alpha": { "light": 0.08, "dark": 0.1 }
    },
    "green": {
      "light": "#2d6a4f",
      "dark": "#5cb88a",
      "tint_alpha": { "light": 0.08, "dark": 0.12 }
    },
    "amber": {
      "light": "#92400e",
      "dark": "#d4a04e",
      "tint_alpha": { "light": 0.08, "dark": 0.12 }
    },
    "blue": {
      "light": "#1e3a5f",
      "dark": "#6ba3d6",
      "tint_alpha": { "light": 0.08, "dark": 0.12 }
    },
    "red": {
      "light": "#7f1d1d",
      "dark": "#e07070",
      "tint_alpha": { "light": 0.08, "dark": 0.12 }
    },
    "teal": { "light": "#2e7d6f", "dark": "#6fd4c4" },
    "lavender": { "light": "#6b4f9e", "dark": "#c4aae8" },
    "warningSurface": {
      "$comment": "Solid warning banner background (e.g. offline banner) — needs to stay dark enough for white text in both themes, unlike the amber badge tint.",
      "light": "#92400e",
      "dark": "#6b4c1a"
    },
    "accentText": {
      "$comment": "Small readable accent text on a tinted chip background (e.g. RAG topic chips) — needs more contrast than the button accent color.",
      "light": "#0b7ea8",
      "dark": "#6dd4ff",
      "tint_alpha": { "light": 0.08, "dark": 0.14 }
    }
  },
  "header_tokens": {
    "$comment": "The app header is an intentionally always-dark masthead in both light and dark theme, so these don't mirror --ink/--paper. Generates --header-* vars in theme.css.",
    "bg": { "light": "#1c1917", "dark": "#111114" },
    "text": { "light": "#faf7f2", "dark": "#faf7f2" },
    "muted": { "light": "#9b9189", "dark": "#c4c0b8" },
    "border": { "light": "#3d3833", "dark": "#3a3a40" },
    "selectBg": { "light": "#2c2825", "dark": "#2a2a30" },
    "sep": { "light": "#4a443e", "dark": "#4a4a52" },
    "accent": { "light": "#5ec4e6", "dark": "#5ec4e6" },
    "writeBorder": { "light": "#4a6a78", "dark": "#3a6a7e" },
    "writeLabel": { "light": "#7a9eab", "dark": "#7a9eab" }
  },
  "content_tokens": {
    "$comment": "Tokens for the standalone reference pages (guide-*.html, dialect-*.html). Generates Parlance/web/content-theme.css + docs/content-theme.css. These pages use a brighter, pastel-card look distinct from the app-shell tokens above, but must still come from this single file — never hand-copy these values into a page's own <style> block.",
    "bg": { "light": "#faf8f4", "dark": "#1a1a1e" },
    "surface": { "light": "#ffffff", "dark": "#242428" },
    "border": { "light": "#e2ddd6", "dark": "#3a3a40" },
    "text": { "light": "#1a1714", "dark": "#e8e0d0" },
    "muted": { "light": "#8a8278", "dark": "#a8a098" },
    "tagBg": { "light": "#f0ece5", "dark": "#2e2e34" },
    "highlight": { "light": "#fff8e8", "dark": "#2a2618" },
    "hues": {
      "$comment": "Each hue drives a nav-badge/level-pill/trigger-chip color family. text = saturated accent color, bg = the pastel chip background behind it.",
      "red": { "text": { "light": "#c0392b", "dark": "#e07070" }, "bg": { "light": "#fdecea", "dark": "rgba(224,112,112,0.12)" } },
      "green": { "text": { "light": "#2e6b4a", "dark": "#5cb88a" }, "bg": { "light": "#eaf3ee", "dark": "rgba(92,184,138,0.12)" } },
      "blue": { "text": { "light": "#1a5c99", "dark": "#6ba3d6" }, "bg": { "light": "#e8f0fb", "dark": "rgba(107,163,214,0.12)" } },
      "gold": { "text": { "light": "#a0742a", "dark": "#d4a04e" }, "bg": { "light": "#fdf0d9", "dark": "rgba(212,160,78,0.12)" } },
      "lavender": { "text": { "light": "#6b4f9e", "dark": "#c4aae8" }, "bg": { "light": "#f0eafa", "dark": "rgba(196,170,232,0.12)" } }
    }
  },
  "raw_css": {
    "shadow": {
      "light": "0 2px 24px rgba(28,25,23,0.08)",
      "dark": "0 2px 24px rgba(0,0,0,0.3)"
    }
  },
  "native_assets": {
    "AccentColor": "accent",
    "Ink": "ink",
    "Paper": "paper",
    "Paper2": "paper2",
    "Rule": "rule",
    "Muted": "muted",
    "StatusGreen": "green",
    "StatusAmber": "amber",
    "StatusBlue": "blue",
    "StatusRed": "red"
  }
}
