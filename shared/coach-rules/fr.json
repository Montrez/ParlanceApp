{
  "version": 1,
  "lang": "fr",
  "standard_version": 1,
  "standard_path": "shared/standards/fr-coach-standard.json",
  "grammar_rule_default": "French agreement, prepositions, mood, and clause structure",
  "rules": [
    {
      "id": "si_clause_conditional_protasis",
      "category": "verb_mood",
      "priority": 8,
      "detect": {
        "pattern": "\\bsi\\b[^.!?]*\\b(j'aurais|tu aurais|il aurait|elle aurait|on aurait|nous aurions|vous auriez|ils auraient|elles auraient)\\b",
        "flags": "i"
      },
      "issue": "After «si» introducing a hypothesis, use the imparfait in the protasis (e.g. «j'avais»), not the conditionnel («j'aurais»).",
      "mention": ["j'avais", "imparfait", "si clause"],
      "repair": [
        { "pattern": "\\bj'aurais\\b", "replace": "j'avais", "flags": "gi" },
        { "pattern": "\\btu aurais\\b", "replace": "tu avais", "flags": "gi" },
        { "pattern": "\\bil aurait\\b", "replace": "il avait", "flags": "gi" },
        { "pattern": "\\belle aurait\\b", "replace": "elle avait", "flags": "gi" },
        { "pattern": "\\bon aurait\\b", "replace": "on avait", "flags": "gi" },
        { "pattern": "\\bnous aurions\\b", "replace": "nous avions", "flags": "gi" },
        { "pattern": "\\bvous auriez\\b", "replace": "vous aviez", "flags": "gi" },
        { "pattern": "\\bils auraient\\b", "replace": "ils avaient", "flags": "gi" },
        { "pattern": "\\belles auraient\\b", "replace": "elles avaient", "flags": "gi" }
      ],
      "grammar_rule": "Si clauses: imparfait in the protasis, conditionnel in the main clause",
      "source": {
        "authority": "Le Bon Usage (Grevisse)",
        "topic": "La phrase hypothétique avec si",
        "url": "https://www.academie-francaise.fr/si-jaurais-plutot-que-si-javais"
      },
      "cefr": { "teach_from": "B1", "band": "B1-B2" },
      "regression": ["si_clause_aurais"]
    },
    {
      "id": "il_faut_que_subjunctive",
      "category": "verb_mood",
      "priority": 9,
      "detect": {
        "pattern": "\\bil faut que\\s+tu\\s+(viens|pars|vas|fais|es|as|dis|peux|veux|sais)\\b",
        "flags": "i"
      },
      "issue": "After «il faut que» (obligation), use the subjunctive, not the present indicative.",
      "mention": ["subjonctif", "il faut que", "tu viennes"],
      "repair": [
        { "pattern": "\\bil faut que\\s+tu\\s+viens\\b", "replace": "il faut que tu viennes", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+pars\\b", "replace": "il faut que tu partes", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+vas\\b", "replace": "il faut que tu ailles", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+fais\\b", "replace": "il faut que tu fasses", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+es\\b", "replace": "il faut que tu sois", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+as\\b", "replace": "il faut que tu aies", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+dis\\b", "replace": "il faut que tu dises", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+peux\\b", "replace": "il faut que tu puisses", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+veux\\b", "replace": "il faut que tu veuilles", "flags": "gi" },
        { "pattern": "\\bil faut que\\s+tu\\s+sais\\b", "replace": "il faut que tu saches", "flags": "gi" }
      ],
      "grammar_rule": "«il faut que» + subjunctive (obligation)",
      "source": {
        "authority": "Bescherelle",
        "topic": "Emploi du subjonctif après il faut que",
        "url": "https://bescherelle.ca/le-subjonctif/"
      },
      "cefr": { "teach_from": "B1", "band": "B1-B2" },
      "regression": ["il_faut_que_viens"]
    },
    {
      "id": "vouloir_que_subjunctive",
      "category": "verb_mood",
      "priority": 10,
      "detect": {
        "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)\\s+que\\s+tu\\s+(viens|pars|vas|fais|es|as|dis|peux|veux|sais)\\b",
        "flags": "i"
      },
      "issue": "After a subjunctive trigger («je veux que», «je voudrais que»…), use the subjunctive, not the present indicative.",
      "mention": ["subjonctif", "je veux que", "tu viennes"],
      "repair": [
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)viens\\b", "replace": "\\1\\2viennes", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)pars\\b", "replace": "\\1\\2partes", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)vas\\b", "replace": "\\1\\2ailles", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)fais\\b", "replace": "\\1\\2fasses", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)es\\b", "replace": "\\1\\2sois", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)as\\b", "replace": "\\1\\2aies", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)dis\\b", "replace": "\\1\\2dises", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)peux\\b", "replace": "\\1\\2puisses", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)veux\\b", "replace": "\\1\\2veuilles", "flags": "gi" },
        { "pattern": "\\b(je veux|je souhaite|j'aimerais|je voudrais)(\\s+que\\s+tu\\s+)sais\\b", "replace": "\\1\\2saches", "flags": "gi" }
      ],
      "grammar_rule": "Subjunctive after «vouloir que» / «souhaiter que»",
      "source": {
        "authority": "Bescherelle",
        "topic": "Emploi du subjonctif après les verbes de volonté",
        "url": "https://bescherelle.ca/le-subjonctif/"
      },
      "cefr": { "teach_from": "B1", "band": "B1" },
      "regression": ["vouloir_que_viens"]
    },
    {
      "id": "ne_pas_missing_pas",
      "category": "negation",
      "priority": 12,
      "detect": {
        "pattern": "\\bne\\s+(sais|peux|veux|suis|ai|vais|comprends|parle)\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))",
        "flags": "i"
      },
      "issue": "Formal and written French negation requires «ne … pas» — don't drop «pas».",
      "mention": ["ne...pas", "negation", "ne sais pas"],
      "repair": [
        { "pattern": "\\bne\\s+sais\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne sais pas", "flags": "gi" },
        { "pattern": "\\bne\\s+peux\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne peux pas", "flags": "gi" },
        { "pattern": "\\bne\\s+veux\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne veux pas", "flags": "gi" },
        { "pattern": "\\bne\\s+suis\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne suis pas", "flags": "gi" },
        { "pattern": "\\bne\\s+ai\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne ai pas", "flags": "gi" },
        { "pattern": "\\bne\\s+vais\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne vais pas", "flags": "gi" },
        { "pattern": "\\bne\\s+comprends\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne comprends pas", "flags": "gi" },
        { "pattern": "\\bne\\s+parle\\b(?!\\s*(pas|jamais|plus|rien|personne|que|guère))", "replace": "ne parle pas", "flags": "gi" }
      ],
      "grammar_rule": "Negation «ne … pas» (formal/written register)",
      "source": {
        "authority": "Bescherelle",
        "topic": "La négation : ne … pas",
        "url": "https://bescherelle.ca/la-negation/"
      },
      "cefr": { "teach_from": "A1", "band": "A1-A2" },
      "regression": ["ne_pas_sais"]
    },
    {
      "id": "french_typography_spacing",
      "category": "punctuation",
      "priority": 15,
      "detect": {
        "pattern": "[A-Za-zÀ-ÿ][?!;:]"
      },
      "issue": "French requires a space before «?», «!», «;», and «:» (typographic spacing).",
      "mention": ["space before punctuation", "typography", "espace"],
      "repair": [
        { "pattern": "([A-Za-zÀ-ÿ])([?!;:])", "replace": "\\1 \\2", "flags": "g" }
      ],
      "grammar_rule": "French typography — space before ? ! ; :",
      "source": {
        "authority": "Imprimerie nationale / Le Bon Usage",
        "topic": "Espacement des signes de ponctuation double",
        "url": "https://www.imprimerienationale.fr/"
      },
      "cefr": { "teach_from": "A1", "band": "A1-A2" },
      "regression": ["typography_question_mark"]
    },
    {
      "id": "je_elision",
      "category": "orthography",
      "priority": 18,
      "detect": {
        "pattern": "\\bje\\s+(ai|aime|aimes|habite|habites|étudie|étudies|arrive|arrives|espère|espères|écoute|écoutes|adore|adores|imagine|imagines|entends)\\b",
        "flags": "i"
      },
      "issue": "«Je» elides to «j'» before a verb beginning with a vowel (e.g. «j'aime», not «je aime»).",
      "mention": ["j'aime", "élision", "apostrophe"],
      "repair": [
        { "pattern": "\\bje\\s+(ai|aime|aimes|habite|habites|étudie|étudies|arrive|arrives|espère|espères|écoute|écoutes|adore|adores|imagine|imagines|entends)\\b", "replace": "j'\\1", "flags": "gi" }
      ],
      "grammar_rule": "Elision: je → j' before a vowel-initial verb",
      "source": {
        "authority": "Académie française",
        "topic": "Élision du pronom je devant une voyelle",
        "url": "https://www.academie-francaise.fr/"
      },
      "cefr": { "teach_from": "A1", "band": "A1" },
      "regression": ["je_elision_aime"]
    },
    {
      "id": "a_preposition_confusion",
      "category": "orthography",
      "priority": 20,
      "detect": {
        "pattern": "\\b(vais|vas|va|allons|allez|vont)\\s+a\\b",
        "flags": "i"
      },
      "issue": "Use the accented preposition «à» after verbs of motion (e.g. «je vais à Paris»), not «a» (the verb avoir).",
      "mention": ["à", "accent grave", "vais à"],
      "repair": [
        { "pattern": "\\b(vais|vas|va|allons|allez|vont)\\s+a\\b", "replace": "\\1 à", "flags": "gi" }
      ],
      "grammar_rule": "Preposition «à» vs verb form «a» (avoir)",
      "source": {
        "authority": "Bescherelle",
        "topic": "Homophones grammaticaux : à / a",
        "url": "https://bescherelle.ca/"
      },
      "cefr": { "teach_from": "A1", "band": "A1" },
      "regression": ["a_preposition_paris"]
    },
    {
      "id": "ou_relative_missing_accent",
      "category": "orthography",
      "priority": 21,
      "detect": {
        "pattern": "\\b(la ville|le pays|la maison|l'endroit|le moment|la région)\\s+ou\\s+(je|tu|il|elle|on|nous|vous|ils|elles)\\b",
        "flags": "i"
      },
      "issue": "Use «où» (where, with a grave accent) for place/time relative clauses, not «ou» (or).",
      "mention": ["où", "accent grave", "relative clause"],
      "repair": [
        { "pattern": "\\b(la ville|le pays|la maison|l'endroit|le moment|la région)\\s+ou\\s+(je|tu|il|elle|on|nous|vous|ils|elles)\\b", "replace": "\\1 où \\2", "flags": "gi" }
      ],
      "grammar_rule": "«où» (relative, place/time) vs «ou» (or)",
      "source": {
        "authority": "Académie française",
        "topic": "Homophones : où / ou",
        "url": "https://www.academie-francaise.fr/"
      },
      "cefr": { "teach_from": "A2", "band": "A2" },
      "regression": ["ou_relative_ville"]
    },
    {
      "id": "la_adverb_accent",
      "category": "orthography",
      "priority": 22,
      "detect": {
        "pattern": "\\b(suis|es|est|sommes|êtes|sont)\\s+la\\b(?=\\s*[.!?]|\\s*$)",
        "flags": "i"
      },
      "issue": "Use «là» (there, with a grave accent) for location, not «la» (the/her).",
      "mention": ["là", "accent grave", "there"],
      "repair": [
        { "pattern": "\\b(suis|es|est|sommes|êtes|sont)\\s+la\\b", "replace": "\\1 là", "flags": "gi" }
      ],
      "grammar_rule": "«là» (adverb of place) vs «la» (article/pronoun)",
      "source": {
        "authority": "Bescherelle",
        "topic": "Homophones grammaticaux : la / là",
        "url": "https://bescherelle.ca/"
      },
      "cefr": { "teach_from": "A1", "band": "A1" },
      "regression": ["la_adverb_place"]
    },
    {
      "id": "cest_vs_ilest_profession",
      "category": "syntax",
      "priority": 25,
      "detect": {
        "pattern": "\\b(il est|elle est)\\s+(un|une)\\s+(médecin|professeur|avocat|avocate|infirmier|infirmière|ingénieur|étudiant|étudiante|interprète)\\b",
        "flags": "i"
      },
      "issue": "With an indefinite article + profession noun, use «c'est un/une …», not «il est un/elle est une …».",
      "mention": ["c'est un", "c'est une", "profession"],
      "repair": [
        { "pattern": "\\bil est\\s+(un|une)\\s+", "replace": "c'est \\1 ", "flags": "gi" },
        { "pattern": "\\belle est\\s+(un|une)\\s+", "replace": "c'est \\1 ", "flags": "gi" }
      ],
      "grammar_rule": "«c'est» + article vs «il/elle est» + bare noun (profession)",
      "source": {
        "authority": "Le Bon Usage (Grevisse)",
        "topic": "Emploi de c'est / il est devant un nom de profession",
        "url": "https://www.lebonusage.com/"
      },
      "cefr": { "teach_from": "A2", "band": "A2-B1" },
      "regression": ["cest_ilest_medecin"]
    },
    {
      "id": "pour_par_purpose",
      "category": "prepositions",
      "priority": 27,
      "detect": {
        "pattern": "\\bpar\\s+(apprendre|comprendre|réussir|améliorer|finir|gagner|progresser)\\b",
        "flags": "i"
      },
      "issue": "Purpose before an infinitive uses «pour» (e.g. «pour apprendre»), not «par».",
      "mention": ["pour", "par vs pour", "purpose"],
      "repair": [
        { "pattern": "\\bpar\\s+(apprendre|comprendre|réussir|améliorer|finir|gagner|progresser)\\b", "replace": "pour \\1", "flags": "gi" }
      ],
      "grammar_rule": "«pour» (purpose) vs «par» (means/agent)",
      "source": {
        "authority": "Académie française",
        "topic": "Emploi des prépositions pour / par",
        "url": "https://www.academie-francaise.fr/"
      },
      "cefr": { "teach_from": "A2", "band": "A2-B1" },
      "regression": ["pour_par_apprendre"]
    },
    {
      "id": "depuis_pour_duration",
      "category": "prepositions",
      "priority": 28,
      "detect": {
        "pattern": "\\b(habite|travaille|vis|étudie)\\s+ici\\s+pour\\s+(deux|trois|quatre|cinq|six|dix|\\d+)\\s+(ans|années|mois)\\b",
        "flags": "i"
      },
      "issue": "For an action continuing from a point in the past to now, use «depuis» + duration, not «pour».",
      "mention": ["depuis", "pour vs depuis", "duration"],
      "repair": [
        { "pattern": "\\b(habite|travaille|vis|étudie)(\\s+ici\\s+)pour(\\s+(?:deux|trois|quatre|cinq|six|dix|\\d+)\\s+(?:ans|années|mois)\\b)", "replace": "\\1\\2depuis\\3", "flags": "gi" }
      ],
      "grammar_rule": "«depuis» (ongoing duration) vs «pour» (intended future duration)",
      "source": {
        "authority": "Bescherelle",
        "topic": "Depuis / pendant / pour + expression de durée",
        "url": "https://bescherelle.ca/"
      },
      "cefr": { "teach_from": "B1", "band": "B1" },
      "regression": ["depuis_pour_ans"]
    },
    {
      "id": "participle_agreement_etre",
      "category": "agreement",
      "priority": 29,
      "detect": {
        "pattern": "\\belle est\\s+(allé|parti|venu|arrivé)\\b",
        "flags": "i"
      },
      "issue": "Past participles agree in gender with the subject when using «être»: «elle est allée», not «elle est allé».",
      "mention": ["participle agreement", "elle est allée", "être"],
      "repair": [
        { "pattern": "\\belle est\\s+allé\\b", "replace": "elle est allée", "flags": "gi" },
        { "pattern": "\\belle est\\s+parti\\b", "replace": "elle est partie", "flags": "gi" },
        { "pattern": "\\belle est\\s+venu\\b", "replace": "elle est venue", "flags": "gi" },
        { "pattern": "\\belle est\\s+arrivé\\b", "replace": "elle est arrivée", "flags": "gi" }
      ],
      "grammar_rule": "Past participle agreement with «être» (gender/number)",
      "source": {
        "authority": "Le Bon Usage (Grevisse)",
        "topic": "Accord du participe passé avec être",
        "url": "https://www.lebonusage.com/"
      },
      "cefr": { "teach_from": "A2", "band": "A2-B1" },
      "regression": ["participle_agreement_elle"]
    },
    {
      "id": "beaucoup_de_agreement",
      "category": "agreement",
      "priority": 30,
      "detect": {
        "pattern": "\\bbeaucoup\\s+des\\s+(\\w+)\\b",
        "flags": "i"
      },
      "issue": "«Beaucoup de» takes «de» before a plural noun in general reference, not the contracted article «des».",
      "mention": ["beaucoup de", "agreement", "partitive"],
      "repair": [
        { "pattern": "\\bbeaucoup\\s+des\\s+(\\w+)\\b", "replace": "beaucoup de \\1", "flags": "gi" }
      ],
      "grammar_rule": "«beaucoup de» + noun (no contracted article for general reference)",
      "source": {
        "authority": "Le Bon Usage (Grevisse)",
        "topic": "Expressions de quantité + de",
        "url": "https://www.lebonusage.com/"
      },
      "cefr": { "teach_from": "A2", "band": "A2" },
      "regression": ["beaucoup_des_gens"]
    },
    {
      "id": "futur_proche_formation",
      "category": "verb_mood",
      "priority": 33,
      "detect": {
        "pattern": "\\b(vais|vas|va|allons|allez|vont)\\s+(pars|part|partons|partez|partent|viens|vient|venons|venez|viennent|fais|fait|faisons|faites|font|dis|dit|disons|dites|disent)\\b",
        "flags": "i"
      },
      "issue": "Futur proche uses «aller» + infinitive — the second verb must stay in the infinitive, not stay conjugated.",
      "mention": ["futur proche", "infinitive", "aller + infinitif"],
      "repair": [
        { "pattern": "\\b(vais|vas|va|allons|allez|vont)\\s+(pars|part|partons|partez|partent)\\b", "replace": "\\1 partir", "flags": "gi" },
        { "pattern": "\\b(vais|vas|va|allons|allez|vont)\\s+(viens|vient|venons|venez|viennent)\\b", "replace": "\\1 venir", "flags": "gi" },
        { "pattern": "\\b(vais|vas|va|allons|allez|vont)\\s+(fais|fait|faisons|faites|font)\\b", "replace": "\\1 faire", "flags": "gi" },
        { "pattern": "\\b(vais|vas|va|allons|allez|vont)\\s+(dis|dit|disons|dites|disent)\\b", "replace": "\\1 dire", "flags": "gi" }
      ],
      "grammar_rule": "Futur proche: aller (conjugated) + infinitive",
      "source": {
        "authority": "Bescherelle",
        "topic": "Le futur proche : aller + infinitif",
        "url": "https://bescherelle.ca/"
      },
      "cefr": { "teach_from": "A1", "band": "A1-A2" },
      "regression": ["futur_proche_pars"]
    },
    {
      "id": "tu_vous_mismatch",
      "category": "register",
      "priority": 35,
      "detect": {
        "pattern": "\\btu\\s+(voulez|pouvez|êtes|avez|allez|faites|dites|savez)\\b",
        "flags": "i"
      },
      "issue": "«Tu» takes second-person singular verb forms — don't mix it with «vous» conjugations.",
      "mention": ["tu/vous", "register", "tu veux"],
      "repair": [
        { "pattern": "\\btu\\s+voulez\\b", "replace": "tu veux", "flags": "gi" },
        { "pattern": "\\btu\\s+pouvez\\b", "replace": "tu peux", "flags": "gi" },
        { "pattern": "\\btu\\s+êtes\\b", "replace": "tu es", "flags": "gi" },
        { "pattern": "\\btu\\s+avez\\b", "replace": "tu as", "flags": "gi" },
        { "pattern": "\\btu\\s+allez\\b", "replace": "tu vas", "flags": "gi" },
        { "pattern": "\\btu\\s+faites\\b", "replace": "tu fais", "flags": "gi" },
        { "pattern": "\\btu\\s+dites\\b", "replace": "tu dis", "flags": "gi" },
        { "pattern": "\\btu\\s+savez\\b", "replace": "tu sais", "flags": "gi" }
      ],
      "grammar_rule": "Register agreement — «tu» + singular verb forms, not «vous» conjugations",
      "source": {
        "authority": "Académie française",
        "topic": "Accord du registre tu/vous",
        "url": "https://www.academie-francaise.fr/"
      },
      "cefr": { "teach_from": "A2", "band": "A2-B1" },
      "regression": ["tu_vous_voulez"]
    },
    {
      "id": "de_le_contraction",
      "category": "articles",
      "priority": 40,
      "detect": {
        "pattern": "\\bde\\s+(le|les)\\b",
        "flags": "i"
