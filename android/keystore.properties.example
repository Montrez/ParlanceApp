# Copy to android/keystore.properties and fill in. That file is gitignored.
# On a build machine you can export PARLANCE_KEYSTORE_FILE,
# PARLANCE_KEYSTORE_PASSWORD, PARLANCE_KEY_ALIAS, and PARLANCE_KEY_PASSWORD instead.
#
# storeFile is resolved relative to the android/ directory.
storeFile=parlance-release.jks
storePassword=
keyAlias=parlance
keyPassword=
